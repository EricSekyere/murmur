<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for ad-hoc signed releases, used by release-macos only while no
  Developer ID is configured (Developer ID builds use Entitlements.plist).

  These builds keep the hardened runtime, which stops other processes injecting
  code (DYLD_INSERT_LIBRARIES) to borrow Murmur's microphone and Accessibility
  grants. Ad-hoc code has no Team ID, though, so library validation would refuse
  even the ONNX Runtime bundled in Contents/Frameworks; it is disabled here and
  only here. Still open: malware that can write to Murmur.app could swap that
  dylib before launch and restore it afterwards, so the bundle seal looks intact
  when macOS checks it. A Developer ID build closes that.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
