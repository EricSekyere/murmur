<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements, applied only when the release job signs with a
  Developer ID (notarization requires the hardened runtime). Unsigned builds
  ignore this file.

  Keep com.apple.security.cs.disable-library-validation out: it would let any
  same-user process plant a dylib that runs with Murmur's microphone and
  Accessibility grants. ONNX Runtime is bundled in Contents/Frameworks and
  re-signed with our Team ID instead (see release.yml), so it loads with
  library validation on.
-->
<plist version="1.0">
<dict>
    <!-- The hardened runtime denies microphone input without this, silently:
         recording would produce nothing even with the user's permission. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
